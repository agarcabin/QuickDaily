<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickDaily" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- NoteEditActivity 使用：透明背景 + 半透弹窗，外部点击可关闭 -->
    <style name="Theme.QuickDaily.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!-- LauncherActivity must not create the normal white starting preview. -->
    <style name="Theme.QuickDaily.Launcher" parent="Theme.QuickDaily.Transparent">
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
