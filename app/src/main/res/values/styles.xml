<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickDairy" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.QuickDairy.Floating" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.QuickDairy.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
